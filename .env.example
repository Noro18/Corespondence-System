# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# For local development you can skip this file entirely (sane defaults apply).

# Generate a real one on the server: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string

# 1 = debug mode (dev only), 0 = production
DJANGO_DEBUG=0

# Comma-separated hostnames/IPs Django will serve.
# For an offline LAN server, add the server's LAN IP, e.g. 192.168.1.10
DJANGO_ALLOWED_HOSTS=192.168.1.10,localhost

# Comma-separated origins for POST/CSRF (https only matters when TLS is used)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database. Leave DB_ENGINE unset (or sqlite3) for the dev SQLite file.
DB_ENGINE=django.db.backends.mysql
DB_NAME=corespondence
DB_USER=corespondence
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306